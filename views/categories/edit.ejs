<%- include("../partials/head") %>
<h1>Edit Category</h1>

<form action="/categories/<%= category.id %>/edit" method="POST">
    <label for="name">Category Name</label>

    <input
        type="text"
        id="name"
        name="name"
        value="<%= category.name %>"
        required
    >

    <button type="submit">
        Update Category
    </button>
</form>

<a href="/categories/<%= category.id %>">
    Back
</a>
<%- include("../partials/footer") %>