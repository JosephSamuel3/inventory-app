<%- include("../partials/head") %>
<%- include("../partials/errorMsg") %>
<h1><%= title %></h1>

<form action="/inventory/<%= item.id %>" method="POST">

    <label for="name">Name</label>
    <input
        type="text"
        id="name"
        name="name"
        value="<%= item.name %>"
        required
    >

    <br><br>

    <label for="description">Description</label>
    <textarea
        id="description"
        name="description"
    ><%= item.description %></textarea>

    <br><br>

    <label for="sku">SKU</label>
    <input
        type="text"
        id="sku"
        name="sku"
        value="<%= item.sku %>"
        required
    >

    <br><br>

    <label for="quantity">Quantity</label>
    <input
        type="number"
        id="quantity"
        name="quantity"
        value="<%= item.quantity %>"
        required
    >

    <br><br>

    <label for="price">Price</label>
    <input
        type="number"
        step="0.01"
        id="price"
        name="price"
        value="<%= item.price %>"
        required
    >

    <br><br>

    <label for="category_id">Category</label>
    <select name="category_id" id="category_id">

        <% categories.forEach(category => { %>
            <option
                value="<%= category.id %>"
                <%= category.id === item.category_id ? "selected" : "" %>
            >
                <%= category.name %>
            </option>
        <% }) %>

    </select>

    <br><br>

    <label for="supplier_id">Supplier</label>
    <select name="supplier_id" id="supplier_id">

        <% suppliers.forEach(supplier => { %>
            <option
                value="<%= supplier.id %>"
                <%= supplier.id === item.supplier_id ? "selected" : "" %>
            >
                <%= supplier.name %>
            </option>
        <% }) %>

    </select>

    <br><br>

    <label for="location_id">Location</label>
    <select name="location_id" id="location_id">

        <% locations.forEach(location => { %>
            <option
                value="<%= location.id %>"
                <%= location.id === item.location_id ? "selected" : "" %>
            >
                <%= location.name %>
            </option>
        <% }) %>

    </select>

    <br><br>

    <button type="submit">
        Update Item
    </button>

</form>

<form action="/inventory/<%= item.id %>/delete" method="POST">
    <button type="submit">
        Delete Item
    </button>
</form>

<br>

<a href="/inventory/<%= item.id %>">
    Back
</a>
<%- include("../partials/footer") %>