<%- include("../partials/head") %>
<h1><%= item.name %></h1>

<p>
    <strong>Description:</strong>
    <%= item.description %>
</p>

<p>
    <strong>SKU:</strong>
    <%= item.sku %>
</p>

<p>
    <strong>Quantity:</strong>
    <%= item.quantity %>
</p>

<p>
    <strong>Price:</strong>
    $<%= item.price %>
</p>

<p>
    <strong>Category:</strong>
    <%= item.category_name %>
</p>

<p>
    <strong>Supplier:</strong>
    <%= item.supplier_name %>
</p>

<p>
    <strong>Storage location:</strong>
    <%= item.location_name %>
</p>

<a href="/inventory/<%= item.id %>/edit">
    Edit Item
</a>

<form action="/inventory/<%= item.id %>/delete" method="POST">
    <button type="submit">
        Delete Item
    </button>
</form>

<br>

<a href="/inventory">
    Back to Inventory
</a>
<%- include("../partials/footer") %>