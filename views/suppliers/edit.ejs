<%- include("../partials/head") %>
<%- include("../partials/errorMsg") %>

<h1>Edit Supplier</h1>

<form action="/suppliers/<%= supplier.id %>/edit" method="POST">

    <label for="name">
        Supplier Name
    </label>

    <input
        type="text"
        id="name"
        name="name"
        value="<%= supplier.name %>"
    >

    <br><br>

    <label for="email">
        Email
    </label>

    <input
        type="email"
        id="email"
        name="email"
        value="<%= supplier.email %>"
    >

    <br><br>

    <label for="phone">
        Phone
    </label>

    <input
        type="text"
        id="phone"
        name="phone"
        value="<%= supplier.phone %>"
    >

    <br><br>

    <button type="submit">
        Update Supplier
    </button>

</form>

<br>

<form action="/suppliers/<%= supplier.id %>/delete" method="POST">

    <button type="submit">
        Delete Supplier
    </button>

</form>

<br>

<a href="/suppliers/<%= supplier.id %>">
    Back
</a>

<%- include("../partials/footer") %>