<%- include("../partials/head") %>
<%- include("../partials/errorMsg") %>

<h1><%= title %></h1>

<form action="/suppliers" method="POST">

    <label for="name">
        Supplier Name
    </label>

    <input
        type="text"
        id="name"
        name="name"
    >

    <br><br>

    <label for="email">
        Email
    </label>

    <input
        type="email"
        id="email"
        name="email"
    >

    <br><br>

    <label for="phone">
        Phone
    </label>

    <input
        type="text"
        id="phone"
        name="phone"
    >

    <br><br>

    <button type="submit">
        Create Supplier
    </button>

</form>

<br>

<a href="/suppliers">
    Back
</a>
<%- include("../partials/footer") %>