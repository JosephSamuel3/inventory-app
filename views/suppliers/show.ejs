<%- include("../partials/head") %>

<h1><%= supplier.name %></h1>

<p>
    <strong>Email:</strong>
    <%= supplier.email %>
</p>

<p>
    <strong>Phone:</strong>
    <%= supplier.phone %>
</p>

<p>
    <strong>Created At:</strong>
    <%= supplier.createdAt %>
</p>

<a href="/suppliers">
    Back to Suppliers
</a>

<h2>Supplied Items</h2>

<% if (items.length === 0) { %>

    <p>No items found.</p>

<% } else { %>

    <ul>

        <% items.forEach(item => { %>

            <li>

                <strong><%= item.name %></strong>

                <br>

                SKU: <%= item.sku %>

                <br>

                Quantity: <%= item.quantity %>

                <br>

                Price: $<%= item.price %>

            </li>

        <% }) %>

    </ul>

<% } %>

<br>

<a href="/suppliers/<%= supplier.id %>/edit">
    Edit Supplier
</a>

<form action="/suppliers/<%= supplier.id %>/delete" method="POST">

    <button type="submit">
        Delete Supplier
    </button>

</form>
<%- include("../partials/footer") %>